# 화면 UI 구성
st.title("✈️ 세계 유명 관광지 검색기")
st.write("궁금한 나라 이름을 입력하거나 선택하면 대표적인 관광지를 추천해 드립니다!")

# 사용자 입력 방식 1: 직접 텍스트 입력
user_input = st.text_input("나라 이름을 입력하세요 (예: 프랑스, 일본, 미국, 이탈리아)", "")

# 검색 버튼
if st.button("관광지 검색"):
    # 입력된 값이 데이터에 있는지 확인 (공백 제거)
    country = user_input.strip()
    
    if country in travel_data:
        st.success(f"🎉 **{country}**의 추천 관광지입니다!")
        
        # 카드 형태로 관광지 출력
        for place in travel_data[country]:
            with st.container():
                st.subheader(f"📍 {place['name']}")
                st.write(place['desc'])
                st.divider()
    elif country == "":
        st.warning("나라 이름을 입력해 주세요!")
    else:
        st.error(f"죄송합니다. '{country}'에 대한 정보가 아직 없습니다. 다른 나라를 입력해 보세요!")

# 사이드바에 추가 정보 제공
st.sidebar.header("💡 사용 방법")
